# copy to .env (local) or add in the vercel dashboard (project > settings > environment variables).
# every VITE_ value is public once built, so never put passwords or private links here.

# the official google form link guests open to rsvp (the "send" link from google forms)
VITE_GOOGLE_FORM_URL=

# optional: the form's "embed html" src (ends in /viewform?embedded=true) to show the form inside the page
VITE_GOOGLE_FORM_EMBED_URL=

# optional: a google maps share link you have verified yourself (open it and confirm the pin)
VITE_GOOGLE_MAPS_URL=

# optional: public site address, used for canonical + social preview urls. vercel fills this automatically on production builds.
VITE_SITE_URL=

# optional override: auto | upcoming | event-day | past
VITE_EVENT_STATUS=auto

# official social pages (full https links). shown in the nav, hero, closing section and footer once set.
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
